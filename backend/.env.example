PORT=5000
NODE_ENV=development

DB_NAME=expense_voucher_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

JWT_SECRET=change_this_to_a_long_random_string
